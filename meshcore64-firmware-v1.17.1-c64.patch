diff --git a/examples/companion_radio/main.cpp b/examples/companion_radio/main.cpp
index 89f0e6cb..8e240df2 100644
--- a/examples/companion_radio/main.cpp
+++ b/examples/companion_radio/main.cpp
@@ -61,7 +61,10 @@ MultiSerialInterface interface_manager;
 #if defined(SERIAL_RX)
   #include <helpers/ArduinoSerialInterface.h>
   ArduinoSerialInterface hardware_serial_interface;
-  HardwareSerial companion_serial(1);
+  #ifndef HW_SERIAL_UART_NUM
+    #define HW_SERIAL_UART_NUM 1
+  #endif
+  HardwareSerial companion_serial(HW_SERIAL_UART_NUM);
 #endif
 
 // platform file system
@@ -113,6 +116,10 @@ void halt() {
   unsigned long last_wifi_reconnect_attempt = 0;
 #endif
 
+#ifndef HW_SERIAL_BAUD_RATE
+  #define HW_SERIAL_BAUD_RATE 115200
+#endif
+
 void setup() {
   Serial.begin(115200);
   board.begin();
@@ -224,8 +231,13 @@ void setup() {
 
 // add hardware serial interface
 #if defined(SERIAL_RX)
-  companion_serial.setPins(SERIAL_RX, SERIAL_TX);
-  companion_serial.begin(115200);
+  // pins passed directly to begin() (not via a separate setPins() call) --
+  // matches Meshtastic's own ESP32 SerialModule pattern
+  // (Serial2.begin(baud, SERIAL_8N1, rxd, txd)), which its firmware repo
+  // notes is what makes ESP32 correctly configure the pin GPIO direction/
+  // mode as part of enabling the UART, rather than relying on state left
+  // behind by an earlier setPins() call.
+  companion_serial.begin(HW_SERIAL_BAUD_RATE, SERIAL_8N1, SERIAL_RX, SERIAL_TX);
   hardware_serial_interface.begin(companion_serial);
   interface_manager.addInterface(InterfaceType::HardwareSerial, &hardware_serial_interface);
 #endif
diff --git a/examples/companion_radio/ui-new/UITask.cpp b/examples/companion_radio/ui-new/UITask.cpp
index 051f3b31..14449e53 100644
--- a/examples/companion_radio/ui-new/UITask.cpp
+++ b/examples/companion_radio/ui-new/UITask.cpp
@@ -41,7 +41,13 @@ public:
     // strip off dash and commit hash by changing dash to null terminator
     // e.g: v1.2.3-abcdef -> v1.2.3
     const char *ver = FIRMWARE_VERSION;
+#ifdef MC64_BUILD
+    // meshcore64: our version is "v1.17.1-c64" -- the suffix IS the point,
+    // so do not strip at the dash (upstream strips a commit hash there).
+    const char *dash = NULL;
+#else
     const char *dash = strchr(ver, '-');
+#endif
 
     int len = dash ? dash - ver : strlen(ver);
     if (len >= sizeof(_version_info)) len = sizeof(_version_info) - 1;
@@ -72,7 +78,14 @@ public:
 
     display.setColor(UIColor::secondary_txt);
     display.setTextSize(1);
+#ifdef MC64_BUILD
+    // meshcore64: which of our builds this is, so a flashed board can be
+    // identified without USB. Replaces the build date, which is the least
+    // useful line here when several of our variants are in circulation.
+    display.drawTextCentered(display.width()/2, 48, MC64_BUILD);
+#else
     display.drawTextCentered(display.width()/2, 48, FIRMWARE_BUILD_DATE);
+#endif
 
     return 1000;
   }
diff --git a/variants/heltec_v3/platformio.ini b/variants/heltec_v3/platformio.ini
