+  -D MAX_CONTACTS=350
+  -D MAX_GROUP_CHANNELS=40
+  -D DISPLAY_CLASS=SSD1306Display
+  -D ENABLE_USB_INTERFACE
+  -D SERIAL_RX=45
+  -D SERIAL_TX=46
+  -D HW_SERIAL_BAUD_RATE=2400
+  -D MC64_BUILD='"mc64 usb 2400"'
+  -D HW_SERIAL_UART_NUM=2
 ; NOTE: DO NOT ENABLE -->  -D MESH_PACKET_LOGGING=1
 ; NOTE: DO NOT ENABLE -->  -D MESH_DEBUG=1
 build_src_filter = ${Heltec_lora32_v3.build_src_filter}
@@ -168,6 +197,53 @@ build_flags =
   -D AUTO_SHUTDOWN_MILLIVOLTS=3400
   -D BLE_DEBUG_LOGGING=1
   -D OFFLINE_QUEUE_SIZE=256
+; --- meshcore64: the c64 link, alongside BLE ---
+; main.cpp's hardware-serial block is guarded by #if defined(SERIAL_RX),
+; so defining these is all it takes to bring the uart up in any companion
+; variant. On the ble build both interfaces coexist through
+; MultiSerialInterface, so a phone can stay connected over bluetooth while
+; the c64 is on the user port.
+  -D SERIAL_RX=45
+  -D SERIAL_TX=46
+  -D HW_SERIAL_BAUD_RATE=2400
+  -D HW_SERIAL_UART_NUM=2
+  -D MC64_BUILD='"mc64 ble 2400"'
+  -D FIRMWARE_VERSION='"v1.17.1-c64"'
+;  -D MESH_PACKET_LOGGING=1
+;  -D MESH_DEBUG=1
+build_src_filter = ${Heltec_lora32_v3.build_src_filter}
+  +<helpers/ui/SSD1306Display.cpp>
+  +<helpers/ui/MomentaryButton.cpp>
+  +<helpers/esp32/*.cpp>
+  +<../examples/companion_radio/*.cpp>
+  +<../examples/companion_radio/ui-new/*.cpp>
+lib_deps =
+  ${Heltec_lora32_v3.lib_deps}
+  densaugeo/base64 @ ~1.4.0
+
+[env:Heltec_v3_companion_radio_ble_600]
+extends = Heltec_lora32_v3
+build_flags =
+  ${Heltec_lora32_v3.build_flags}
+  -I examples/companion_radio/ui-new
+  -D MAX_CONTACTS=350
+  -D MAX_GROUP_CHANNELS=40
+  -D DISPLAY_CLASS=SSD1306Display
+  -D BLE_PIN_CODE=123456   ; dynamic, random PIN
+  -D AUTO_SHUTDOWN_MILLIVOLTS=3400
+  -D BLE_DEBUG_LOGGING=1
+  -D OFFLINE_QUEUE_SIZE=256
+; --- meshcore64: the c64 link, alongside BLE ---
+; main.cpp's hardware-serial block is guarded by #if defined(SERIAL_RX),
+; so defining these is all it takes to bring the uart up in any companion
+; variant. On the ble build both interfaces coexist through
+; MultiSerialInterface, so a phone can stay connected over bluetooth while
+; the c64 is on the user port.
+  -D SERIAL_RX=45
+  -D SERIAL_TX=46
+  -D HW_SERIAL_BAUD_RATE=600
+  -D HW_SERIAL_UART_NUM=2
+  -D MC64_BUILD='"mc64 ble 600"'
 ;  -D MESH_PACKET_LOGGING=1
 ;  -D MESH_DEBUG=1
 build_src_filter = ${Heltec_lora32_v3.build_src_filter}
